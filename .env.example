# Local development only. Choose a password and use the same value in DATABASE_URL.
POSTGRES_USER=curriculum
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=curriculum

# Next.js runs on your computer; Docker exposes PostgreSQL on localhost:5432.
# URL-encode special characters in the password when writing DATABASE_URL.
DATABASE_URL="postgresql://curriculum:local_dev_password@localhost:5432/curriculum?schema=public"
